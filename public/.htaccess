# This folder is the document root. The parent directory denies everything,
# so access is granted back here - and only here.
#
# Both this line and the parent's "Require all denied" ship inside the
# archive on purpose. Adding either by hand after extracting is how the
# protection quietly disappears at the next deployment, because tar
# overwrites whatever it carries.
Require all granted

# Everything goes through index.php.
RewriteEngine On

# P5-M58: /assets is both a screen (the equipment register) and the folder of stylesheets and images.
# Apache answered /assets with the folder - a redirect to /assets/, then a refused directory listing -
# so the screen never opened in production. The screen's own address goes to the application; the
# files inside the folder are still served as files.
DirectorySlash Off
RewriteRule ^assets/?$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# The app never needs to serve these.
<FilesMatch "\.(sql|json|md|log)$">
  Require all denied
</FilesMatch>
# PHP writes its own log here as "error_log", with no extension, so the
# rule above never matched it. It holds paths and failing queries.
<Files "error_log">
  Require all denied
</Files>

<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

Options -Indexes
